FROM makeplane/plane-aio-community:stable

# Patch Caddyfile for Railway: remove ACME block, bind to $PORT
RUN awk 'BEGIN{s=0} /^\{$/ && !s{s=1;next} /^\}$/ && s{s=0;next} !s' \
    /app/proxy/Caddyfile > /tmp/Caddyfile && \
    sed -i 's|{$SITE_ADDRESS}|:{$PORT}|' /tmp/Caddyfile && \
    cp /tmp/Caddyfile /app/proxy/Caddyfile
